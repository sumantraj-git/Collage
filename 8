#include <stdio.h>
//calculate the simple interest
int main()
{
float principal, rate, time;
printf("enter the value of principal, rate & time");
scanf("%f, %f, %f", &principal, &rate, &time);

printf("the simple interest is : %f \n", (principal*rate*time)/100);
printf("the net amount is:%f \n", (principal*(100+(rate*time)))/100);

    return 0;
}

#include <stdio.h>
#include <math.h>
//calculate the compound interest
int main()
{
    float principal,rate, time, n, CI, A;
    
    printf("enter the value of principal, rate, time, n(compunding freq)");
    scanf("%f, %f, %f, %f", &principal, &rate, &time, &n);
    
    A=principal*pow((1+rate/n), n*time);
    CI= A-principal;
    
    printf("compound interest: %f \n", CI);
    printf("net amount: %f \n", A);
    return 0;
}